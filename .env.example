# Plantilla de variables de entorno para el despliegue Docker.
# Copiá este archivo a ".env" y completá con los valores reales de tu Supabase.
#
#   cp .env.example .env
#
# docker-entrypoint.sh usa estas variables para generar config.js en el contenedor.

# URL pública de tu instancia de Supabase (usá HTTPS en producción; HTTP da mixed-content en PWA)
SUPABASE_URL=https://tu-instancia.supabase.co

# Clave anónima (anon / public) de Supabase. NUNCA pongas la service_role key acá.
SUPABASE_ANON_KEY=tu-anon-key
