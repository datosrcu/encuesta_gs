# Plantilla de variables de entorno para el despliegue Docker.
# Copiá este archivo a ".env" y completá con los valores reales de tu base de datos MySQL.
#
#   cp .env.example .env
#

# Servidor de base de datos MySQL / MariaDB (Internal Host o IP pública)
DB_HOST=bases-de-datosmysql-encuestas-r7v7gg

# Puerto de MySQL (por defecto 3306)
DB_PORT=3306

# Usuario de MySQL
DB_USER=mysql

# Contraseña de la base de datos
DB_PASSWORD=tu-contrasenia-aqui

# Nombre de la base de datos a utilizar
DB_NAME=mysql

# URL del Web App de Google Apps Script para sincronización en tiempo real
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/TU_SCRIPT_ID_AQUI/exec

